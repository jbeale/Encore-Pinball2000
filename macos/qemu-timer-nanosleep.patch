--- a/util/qemu-timer.c	2026-09-12 11:40:37
+++ b/util/qemu-timer.c	2026-09-12 11:39:03
@@ -341,6 +341,19 @@
         return ppoll((struct pollfd *)fds, nfds, &ts, NULL);
     }
 #else
+    /* Encore/macOS: g_poll() only has millisecond granularity, which caps
+     * sub-millisecond QEMU timers (the Pinball 2000 250 us IRQ0 pacer) at
+     * ~1 kHz.  For short timeouts poll once without blocking, then sleep
+     * the exact remainder with nanosleep() and poll again. */
+    if (timeout > 0 && timeout < 4 * SCALE_MS) {
+        int ret = g_poll(fds, nfds, 0);
+        if (ret != 0) {
+            return ret;
+        }
+        struct timespec ts = { .tv_sec = 0, .tv_nsec = (long)timeout };
+        nanosleep(&ts, NULL);
+        return g_poll(fds, nfds, 0);
+    }
     return g_poll(fds, nfds, qemu_timeout_ns_to_ms(timeout));
 #endif
 }
